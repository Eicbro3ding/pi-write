{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"outDir": "dist",
		"rootDir": ".",
		"composite": false,
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true
	},
	"include": [
		"src/**/*.ts",
		"vendor/**/*.ts"
	],
	"exclude": [
		"node_modules",
		"dist",
		"test"
	]
}
