{
	"name": "pi-writer",
	"version": "0.3.1",
	"description": "Standalone creative writing agent built on pi: book/chapter sessions, world-book tree, writer tools",
	"type": "module",
	"bin": {
		"pi-writer": "dist/src/cli.js"
	},
	"main": "./dist/electron/main.cjs",
	"types": "./dist/src/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/src/index.d.ts",
			"import": "./dist/src/index.js"
		}
	},
	"files": [
		"dist",
		"skills",
		"README.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json && shx chmod +x dist/cli.js",
		"bundle": "node scripts/check-bun.mjs && bun build src/cli.ts --compile --outfile release/pi-writer.exe && shx rm -rf release/skills release/theme && shx cp -r skills release/skills && shx mkdir -p release/theme && shx cp vendor/pi-coding-agent/src/modes/interactive/theme/*.json release/theme/ && shx cp package.json README.md release/",
		"test": "vitest --run",
		"prepublishOnly": "npm run clean && npm run build",
		"build:web": "node scripts/web-build.mjs",
		"web": "node dist/web/server.cjs",
		"electron": "electron dist/electron/main.cjs",
		"build:electron": "bun build electron/main.ts --outfile dist/electron/main.cjs --external \"electron*\" --target node --format cjs && bun build electron/preload.ts --outfile dist/electron/preload.js --target node --format cjs"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "0.91.1",
		"@aws-sdk/client-bedrock-runtime": "3.1048.0",
		"@codemirror/lang-markdown": "6.3.1",
		"@codemirror/view": "^6.43.8",
		"@google/genai": "1.52.0",
		"@mistralai/mistralai": "2.2.6",
		"@modelcontextprotocol/sdk": "^1.30.0",
		"@opentelemetry/api": "1.9.0",
		"@replit/codemirror-vim": "6.2.1",
		"@silvia-odwyer/photon-node": "0.3.4",
		"@smithy/node-http-handler": "4.7.3",
		"busboy": "^1.6.0",
		"chalk": "5.6.2",
		"codemirror": "6.0.1",
		"cross-spawn": "7.0.6",
		"cytoscape": "3.34.0",
		"cytoscape-cola": "^2.5.1",
		"diff": "8.0.4",
		"framer-motion": "11.18.2",
		"get-east-asian-width": "1.6.0",
		"glob": "13.0.6",
		"highlight.js": "10.7.3",
		"hosted-git-info": "9.0.3",
		"http-proxy-agent": "7.0.2",
		"https-proxy-agent": "7.0.6",
		"ignore": "7.0.5",
		"jiti": "2.7.0",
		"marked": "18.0.5",
		"minimatch": "10.2.5",
		"openai": "6.26.0",
		"partial-json": "0.1.7",
		"proper-lockfile": "4.1.2",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"semver": "7.8.0",
		"typebox": "1.3.7",
		"undici": "6.28.0",
		"yaml": "2.9.0",
		"yauzl": "3.4.0",
		"yazl": "3.3.1"
	},
	"keywords": [
		"writing-agent",
		"creative-writing",
		"pi",
		"agent",
		"llm",
		"cli"
	],
	"author": "Pi Contributors",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Eicbro3ding/pi-writer.git"
	},
	"engines": {
		"node": ">=18.20.4"
	},
	"devDependencies": {
		"@types/busboy": "^1.5.4",
		"@types/cross-spawn": "6.0.6",
		"@types/cytoscape": "3.21.9",
		"@types/diff": "7.0.2",
		"@types/hosted-git-info": "3.0.5",
		"@types/ms": "2.1.0",
		"@types/node": "24.12.4",
		"@types/proper-lockfile": "4.1.4",
		"@types/react": "18.3.12",
		"@types/react-dom": "18.3.1",
		"@types/semver": "7.7.1",
		"@types/yauzl": "3.4.0",
		"@types/yazl": "3.3.1",
		"@vitejs/plugin-react": "4.3.4",
		"electron": "^43.2.0",
		"electron-builder": "^26.15.3",
		"esbuild": "^0.28.1",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"shx": "0.4.0",
		"typescript": "5.9.3",
		"vite": "6.0.7",
		"vitest": "4.1.9"
	}
}
